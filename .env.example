# Copy to .env.local and fill in. Never commit real values.
# Everything here is free tier. No variable enables a paid service by default.

# --- Live AI: Cloudflare Workers AI (free: 10,000 neurons/day) ---------------
# Keep the Cloudflare account on the Workers FREE plan: past the free allocation,
# requests fail instead of being billed.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
# API token with only the "Workers AI: Read" permission. Server-only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Usage protection ---------------------------------------------------------
LIVE_AI_ENABLED=true            # global kill switch: false stops every live AI request
DAILY_USER_MISSIONS=1
DAILY_GLOBAL_MISSIONS=20        # ~300 neurons/mission keeps this well under 10,000
DAILY_IP_MISSIONS=3
MAX_MISSION_INPUT_CHARS=6000    # hard ceiling 6000
MAX_OUTPUT_TOKENS=1200          # hard ceiling 1200
IP_HASH_SALT=                   # any long random string; IPs are stored only as salted hashes

# --- Cloudflare Turnstile (free) ----------------------------------------------
# Required on deployments; live missions fail closed without it.
# Local testing keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase Free (auth and persistence) -------------------------------------
# Without these, local dev uses .forge-data/db.json plus a dev-only username sign-in.
# Run supabase/schema.sql first. The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only; used ONLY for the quota ledger

# --- Anthropic (PAID, off by default) -----------------------------------------
# Full Swarm runs only in local development, only when both of these are set.
# It is never offered on a deployment, and never with a shared key.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
